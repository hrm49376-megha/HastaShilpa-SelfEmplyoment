<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@color/background_light"
    tools:context=".MaterialActivity">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/tracker_title"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/primary_green" />

    <EditText
        android:id="@+id/etBamboo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/hint_bamboo_poles"
        android:inputType="number"
        android:importantForAutofill="no"
        android:layout_marginTop="20dp"
        android:textColor="@color/black"
        android:textColorHint="@color/text_secondary" />

    <EditText
        android:id="@+id/etHours"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/hint_hours_worked"
        android:inputType="number"
        android:importantForAutofill="no"
        android:layout_marginTop="20dp"
        android:textColor="@color/black"
        android:textColorHint="@color/text_secondary" />

    <Button
        android:id="@+id/btnCalculate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_calculate_price"
        android:backgroundTint="@color/primary_green"
        android:layout_marginTop="30dp" />

    <TextView
        android:id="@+id/tvResult"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/primary_green"
        android:layout_marginTop="30dp"
        tools:text="Suggested Price: ₹500" />

</LinearLayout>